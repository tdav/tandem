<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared source: the counting stream of any declared size from the Core tests. -->
    <Compile Include="..\Tandem.Core.Tests\Viewing\SparseStream.cs" Link="ViewModels\SparseStream.cs" />
    <!-- Shared source: a remote source whose connection can be lost, from the Core tests. -->
    <Compile Include="..\Tandem.Core.Tests\Vfs\DroppingProvider.cs" Link="ViewModels\DroppingProvider.cs" />
    <!-- The archive fixtures and their loader (skips a test whose external fixture is absent). -->
    <Compile Include="..\Tandem.Archives.Tests\Fixture.cs" Link="Views\Fixture.cs" />
    <Compile Include="..\Tandem.Net.Tests\Remote\FakeRemoteServer.cs" Link="Integration\FakeRemoteServer.cs" />
    <Compile Include="..\Tandem.Core.Tests\Platform\FakeSecretStore.cs" Link="Integration\FakeSecretStore.cs" />
    <Compile Include="..\Tandem.Net.Tests\Ftp\TestFtpServer.cs" Link="Integration\TestFtpServer.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Tandem.Archives.Tests\Fixtures\**" Exclude="..\Tandem.Archives.Tests\Fixtures\*.sh;..\Tandem.Archives.Tests\Fixtures\*.py;..\Tandem.Archives.Tests\Fixtures\README.md" LinkBase="Fixtures" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\external\**" Exclude="..\fixtures\external\README.md" LinkBase="Fixtures\external" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tandem.App\Tandem.App.csproj" />
  </ItemGroup>
</Project>
