<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tandem.Archives\Tandem.Archives.csproj" />
    <ProjectReference Include="..\..\src\Tandem.Core\Tandem.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Tandem.Core.Tests\Operations\ScriptedInteraction.cs" Link="Operations\ScriptedInteraction.cs" />
    <Compile Include="..\Tandem.Core.Tests\Vfs\TempDir.cs" Link="Vfs\TempDir.cs" />
    <Compile Include="..\Tandem.Core.Tests\Vfs\ProviderContractTests.cs" Link="Vfs\ProviderContractTests.cs" />
    <Compile Include="..\Tandem.Core.Tests\Vfs\HostedFileSystem.cs" Link="Vfs\HostedFileSystem.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" Exclude="Fixtures\*.sh;Fixtures\*.py;Fixtures\README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\external\**" Exclude="..\fixtures\external\README.md" LinkBase="Fixtures\external" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
