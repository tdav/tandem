<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- UI -->
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.6" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <!-- Archives -->
    <PackageVersion Include="SharpCompress" Version="1.0.0" />
    <!-- Tools (Tandem.Core) -->
    <PackageVersion Include="System.IO.Hashing" Version="11.0.0" />
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
    <!-- Network (Tandem.Net) -->
    <PackageVersion Include="SSH.NET" Version="2026.0.1" />
    <PackageVersion Include="FluentFTP" Version="55.1.0" />
    <PackageVersion Include="XTerm.NET" Version="3.0.3" />
    <!-- Tests: xunit.v3 3.2.x is what Avalonia.Headless.XUnit 12.1.6 is built against -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
