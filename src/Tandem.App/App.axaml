<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tandem.App.App"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the system's light or dark appearance. -->

    <Application.Resources>
        <ResourceDictionary>
            <!-- Every colour the views use, in a light and a dark variant. Views refer to these keys only. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Tandem.BarBackground" Color="#FFF4F4F5" />
                    <SolidColorBrush x:Key="Tandem.HeaderBackground" Color="#FFEDEDEF" />
                    <SolidColorBrush x:Key="Tandem.DividerBrush" Color="#FFD4D4D8" />
                    <SolidColorBrush x:Key="Tandem.SecondaryForeground" Color="#FF6B6B73" />
                    <SolidColorBrush x:Key="Tandem.PathBackground" Color="#FFE4E4E7" />
                    <SolidColorBrush x:Key="Tandem.PathForeground" Color="#FF3F3F46" />
                    <SolidColorBrush x:Key="Tandem.ActivePathBackground" Color="#FF2563EB" />
                    <SolidColorBrush x:Key="Tandem.ActivePathForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="Tandem.CursorBackground" Color="#FFCFE0FF" />
                    <SolidColorBrush x:Key="Tandem.CursorBorder" Color="#FF2563EB" />
                    <SolidColorBrush x:Key="Tandem.MarkedForeground" Color="#FFD21F3C" />
                    <SolidColorBrush x:Key="Tandem.ErrorForeground" Color="#FFB91C1C" />
                    <SolidColorBrush x:Key="Tandem.TabActiveBackground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="Tandem.Transparent" Color="#00FFFFFF" />
                    <SolidColorBrush x:Key="Tandem.DropTargetBackground" Color="#FFD9F2E0" />
                    <SolidColorBrush x:Key="Tandem.DropTargetBorder" Color="#FF16A34A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Tandem.BarBackground" Color="#FF232326" />
                    <SolidColorBrush x:Key="Tandem.HeaderBackground" Color="#FF2A2A2E" />
                    <SolidColorBrush x:Key="Tandem.DividerBrush" Color="#FF3F3F46" />
                    <SolidColorBrush x:Key="Tandem.SecondaryForeground" Color="#FFA1A1AA" />
                    <SolidColorBrush x:Key="Tandem.PathBackground" Color="#FF333338" />
                    <SolidColorBrush x:Key="Tandem.PathForeground" Color="#FFD4D4D8" />
                    <SolidColorBrush x:Key="Tandem.ActivePathBackground" Color="#FF3B82F6" />
                    <SolidColorBrush x:Key="Tandem.ActivePathForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="Tandem.CursorBackground" Color="#FF1E3A66" />
                    <SolidColorBrush x:Key="Tandem.CursorBorder" Color="#FF60A5FA" />
                    <SolidColorBrush x:Key="Tandem.MarkedForeground" Color="#FFFF6B81" />
                    <SolidColorBrush x:Key="Tandem.ErrorForeground" Color="#FFF87171" />
                    <SolidColorBrush x:Key="Tandem.TabActiveBackground" Color="#FF3A3A40" />
                    <SolidColorBrush x:Key="Tandem.Transparent" Color="#00000000" />
                    <SolidColorBrush x:Key="Tandem.DropTargetBackground" Color="#FF1C4A2E" />
                    <SolidColorBrush x:Key="Tandem.DropTargetBorder" Color="#FF4ADE80" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Flat buttons of the bars (volumes, tabs, headers, F-keys, sidebar): they never take the focus, so the
             keyboard stays with the file list. -->
        <Style Selector="Button.flat">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="{DynamicResource Tandem.Transparent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource Tandem.SecondaryForeground}" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="Foreground" Value="{DynamicResource Tandem.SecondaryForeground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="8,8,8,2" />
        </Style>
    </Application.Styles>
</Application>
