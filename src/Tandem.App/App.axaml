<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tandem.App.App"
             Name="Tandem"
             RequestedThemeVariant="Default">
    <!-- Name: the title of the macOS application menu (bold, leftmost in the menu bar) and of its system items
         ("Hide Tandem", "Quit Tandem"); Avalonia also gives it to the process, so an unbundled `dotnet run` shows it
         too. Without it the menu reads "Avalonia Application".
         "Default" follows the system's light or dark appearance. -->

    <Application.Resources>
        <ResourceDictionary>
            <!-- Every colour the views use, in a light and a dark variant. Views refer to these keys only. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- The design system tokens (Tandem.Color.*, Tandem.* brushes, the views' keys, Fluent's control
                         brushes, the file list icons) are written by ThemeService from the applied theme
                         (Services/ThemeResourceMap.cs). -->
                    <SolidColorBrush x:Key="Tandem.Transparent" Color="#00FFFFFF" />
                    <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#00000000" />
                    <!-- No design system token: kept as they were (marked files, errors, drag and drop, the comparison,
                         the colour rules' palette, hidden entries). -->
                    <SolidColorBrush x:Key="Tandem.MarkedForeground" Color="#FFD21F3C" />
                    <SolidColorBrush x:Key="Tandem.ErrorForeground" Color="#FFB91C1C" />
                    <SolidColorBrush x:Key="Tandem.DropTargetBackground" Color="#FFD9F2E0" />
                    <SolidColorBrush x:Key="Tandem.DropTargetBorder" Color="#FF16A34A" />
                    <SolidColorBrush x:Key="Tandem.DiffChangedBackground" Color="#FFFFF5D8" />
                    <SolidColorBrush x:Key="Tandem.DiffAddedBackground" Color="#FFE7F5E9" />
                    <SolidColorBrush x:Key="Tandem.DiffRemovedBackground" Color="#FFFCE8E8" />
                    <SolidColorBrush x:Key="Tandem.DiffInlineBackground" Color="#FFF9D987" />
                    <!-- File colours: the palette colour rules name (AppSettings.ColorNames). -->
                    <SolidColorBrush x:Key="Tandem.FileColor.Red" Color="#FFC62828" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Orange" Color="#FFC2570C" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Yellow" Color="#FF8A6D00" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Green" Color="#FF2E7D32" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Teal" Color="#FF00796B" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Blue" Color="#FF1565C0" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Purple" Color="#FF6A1B9A" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Gray" Color="#FF6B6B73" />
                    <!-- Icons of hidden entries (dot-names, UF_HIDDEN, the Windows Hidden attribute), in lilac. -->
                    <SolidColorBrush x:Key="Tandem.HiddenIcon" Color="#FF9C88D8" />
                    <SolidColorBrush x:Key="Tandem.HiddenIconAccent" Color="#FFCFC4F0" />
                    <SolidColorBrush x:Key="Tandem.HiddenIconBorder" Color="#FF5B47A0" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <!-- The design system tokens (Tandem.Color.*, Tandem.* brushes, the views' keys, Fluent's control
                         brushes, the file list icons) are written by ThemeService from the applied theme
                         (Services/ThemeResourceMap.cs). -->
                    <SolidColorBrush x:Key="Tandem.Transparent" Color="#00000000" />
                    <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#00000000" />
                    <!-- No design system token: kept as they were (marked files, errors, drag and drop, the comparison,
                         the colour rules' palette, hidden entries). -->
                    <SolidColorBrush x:Key="Tandem.MarkedForeground" Color="#FFFF6B81" />
                    <SolidColorBrush x:Key="Tandem.ErrorForeground" Color="#FFF87171" />
                    <SolidColorBrush x:Key="Tandem.DropTargetBackground" Color="#FF1C4A2E" />
                    <SolidColorBrush x:Key="Tandem.DropTargetBorder" Color="#FF4ADE80" />
                    <SolidColorBrush x:Key="Tandem.DiffChangedBackground" Color="#FF43381F" />
                    <SolidColorBrush x:Key="Tandem.DiffAddedBackground" Color="#FF1E3D2C" />
                    <SolidColorBrush x:Key="Tandem.DiffRemovedBackground" Color="#FF49272C" />
                    <SolidColorBrush x:Key="Tandem.DiffInlineBackground" Color="#FF63501C" />
                    <!-- File colours: the palette colour rules name (AppSettings.ColorNames). -->
                    <SolidColorBrush x:Key="Tandem.FileColor.Red" Color="#FFFF8A80" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Orange" Color="#FFFFB74D" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Yellow" Color="#FFFFE082" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Green" Color="#FF81C784" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Teal" Color="#FF4DB6AC" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Blue" Color="#FF64B5F6" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Purple" Color="#FFCE93D8" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Gray" Color="#FFA1A1AA" />
                    <SolidColorBrush x:Key="Tandem.HiddenIcon" Color="#FF6E5BB0" />
                    <SolidColorBrush x:Key="Tandem.HiddenIconAccent" Color="#FF9583D0" />
                    <SolidColorBrush x:Key="Tandem.HiddenIconBorder" Color="#FFC9BDF2" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Small glyphs drawn as vector paths (16×16 design box); views colour them with the brushes above. -->
            <!-- A push pin, filled: a pinned tab. -->
            <StreamGeometry x:Key="Tandem.PinGlyph">M5,1 L11,1 L11,2.5 L10,2.5 L10,7 L12.5,9.5 L12.5,10.5 L8.6,10.5 L8,15.5 L7.4,10.5 L3.5,10.5 L3.5,9.5 L6,7 L6,2.5 L5,2.5 Z</StreamGeometry>
            <!-- A cross, stroked: a tab's close button. -->
            <StreamGeometry x:Key="Tandem.CloseGlyph">M3,3 L13,13 M13,3 L3,13</StreamGeometry>
            <!-- The file list's row padding; the column headers use it too, so each header starts where its cells
                 start. -->
            <Thickness x:Key="Tandem.ListItemPadding">6,0</Thickness>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <!-- Fluent's own palette on the design system: its accent is the input colour (focus, not the
                 navigation accent), the window background the surface, the main text the ink. -->
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#FF7C3F21" RegionColor="#FFBBB8B0" BaseHigh="#FF1B1A18" />
                <ColorPaletteResources x:Key="Dark" Accent="#FFC7754F" RegionColor="#FF2A2927" BaseHigh="#FFDBD7CE" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <!-- The built-in text editor's own look (AvaloniaEdit's Fluent theme). -->
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <!-- The app icon in the title bar and the taskbar of every window (the main one, dialogs, viewer, editor…).
             Generated from build/icon/tandem.svg by build/icon/make-icons.py. -->
        <Style Selector=":is(Window)">
            <Setter Property="Icon" Value="avares://Tandem.App/Assets/Tandem.ico" />
            <!-- The theme's interface font (ThemeService writes Tandem.Font.Ui). -->
            <Setter Property="FontFamily" Value="{DynamicResource Tandem.Font.Ui}" />
        </Style>

        <!-- Flat buttons of the bars (volumes, tabs, headers, F-keys, sidebar): they never take the focus, so the
             keyboard stays with the file list. -->
        <Style Selector="Button.flat">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="{DynamicResource Tandem.Transparent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Selected text in a field: on-focus on the focus colour (TextControlSelectionHighlightColor). -->
        <Style Selector="TextBox">
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Tandem.OnFocus}" />
        </Style>
        <Style Selector="SelectableTextBlock">
            <Setter Property="SelectionBrush" Value="{DynamicResource Tandem.Focus}" />
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Tandem.OnFocus}" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource Tandem.SecondaryForeground}" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="Foreground" Value="{DynamicResource Tandem.SecondaryForeground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="8,8,8,2" />
        </Style>
    </Application.Styles>
</Application>
