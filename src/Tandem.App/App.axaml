<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tandem.App.App"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the system's light or dark appearance. -->

    <Application.Resources>
        <ResourceDictionary>
            <!-- Every colour the views use, in a light and a dark variant. Views refer to these keys only. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Tandem.BarBackground" Color="#FFF4F4F5" />
                    <SolidColorBrush x:Key="Tandem.HeaderBackground" Color="#FFEDEDEF" />
                    <SolidColorBrush x:Key="Tandem.DividerBrush" Color="#FFD4D4D8" />
                    <SolidColorBrush x:Key="Tandem.SecondaryForeground" Color="#FF6B6B73" />
                    <SolidColorBrush x:Key="Tandem.PathBackground" Color="#FFE4E4E7" />
                    <SolidColorBrush x:Key="Tandem.PathForeground" Color="#FF3F3F46" />
                    <SolidColorBrush x:Key="Tandem.ActivePathBackground" Color="#FF2563EB" />
                    <SolidColorBrush x:Key="Tandem.ActivePathForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="Tandem.CursorBackground" Color="#FFCFE0FF" />
                    <SolidColorBrush x:Key="Tandem.CursorBorder" Color="#FF2563EB" />
                    <SolidColorBrush x:Key="Tandem.MarkedForeground" Color="#FFD21F3C" />
                    <SolidColorBrush x:Key="Tandem.ErrorForeground" Color="#FFB91C1C" />
                    <SolidColorBrush x:Key="Tandem.TabActiveBackground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="Tandem.Transparent" Color="#00FFFFFF" />
                    <SolidColorBrush x:Key="Tandem.DropTargetBackground" Color="#FFD9F2E0" />
                    <SolidColorBrush x:Key="Tandem.DropTargetBorder" Color="#FF16A34A" />
                    <SolidColorBrush x:Key="Tandem.ViewerBackground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="Tandem.ViewerForeground" Color="#FF18181B" />
                    <SolidColorBrush x:Key="Tandem.ViewerSelection" Color="#FFBFD7FF" />
                    <!-- File colours: the palette colour rules name (AppSettings.ColorNames). -->
                    <SolidColorBrush x:Key="Tandem.FileColor.Red" Color="#FFC62828" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Orange" Color="#FFC2570C" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Yellow" Color="#FF8A6D00" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Green" Color="#FF2E7D32" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Teal" Color="#FF00796B" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Blue" Color="#FF1565C0" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Purple" Color="#FF6A1B9A" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Gray" Color="#FF6B6B73" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Tandem.BarBackground" Color="#FF232326" />
                    <SolidColorBrush x:Key="Tandem.HeaderBackground" Color="#FF2A2A2E" />
                    <SolidColorBrush x:Key="Tandem.DividerBrush" Color="#FF3F3F46" />
                    <SolidColorBrush x:Key="Tandem.SecondaryForeground" Color="#FFA1A1AA" />
                    <SolidColorBrush x:Key="Tandem.PathBackground" Color="#FF333338" />
                    <SolidColorBrush x:Key="Tandem.PathForeground" Color="#FFD4D4D8" />
                    <SolidColorBrush x:Key="Tandem.ActivePathBackground" Color="#FF3B82F6" />
                    <SolidColorBrush x:Key="Tandem.ActivePathForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="Tandem.CursorBackground" Color="#FF1E3A66" />
                    <SolidColorBrush x:Key="Tandem.CursorBorder" Color="#FF60A5FA" />
                    <SolidColorBrush x:Key="Tandem.MarkedForeground" Color="#FFFF6B81" />
                    <SolidColorBrush x:Key="Tandem.ErrorForeground" Color="#FFF87171" />
                    <SolidColorBrush x:Key="Tandem.TabActiveBackground" Color="#FF3A3A40" />
                    <SolidColorBrush x:Key="Tandem.Transparent" Color="#00000000" />
                    <SolidColorBrush x:Key="Tandem.DropTargetBackground" Color="#FF1C4A2E" />
                    <SolidColorBrush x:Key="Tandem.DropTargetBorder" Color="#FF4ADE80" />
                    <SolidColorBrush x:Key="Tandem.ViewerBackground" Color="#FF1C1C1E" />
                    <SolidColorBrush x:Key="Tandem.ViewerForeground" Color="#FFE4E4E7" />
                    <SolidColorBrush x:Key="Tandem.ViewerSelection" Color="#FF264F78" />
                    <!-- File colours: the palette colour rules name (AppSettings.ColorNames). -->
                    <SolidColorBrush x:Key="Tandem.FileColor.Red" Color="#FFFF8A80" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Orange" Color="#FFFFB74D" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Yellow" Color="#FFFFE082" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Green" Color="#FF81C784" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Teal" Color="#FF4DB6AC" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Blue" Color="#FF64B5F6" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Purple" Color="#FFCE93D8" />
                    <SolidColorBrush x:Key="Tandem.FileColor.Gray" Color="#FFA1A1AA" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Small glyphs drawn as vector paths (16×16 design box); views colour them with the brushes above. -->
            <!-- A push pin, filled: a pinned tab. -->
            <StreamGeometry x:Key="Tandem.PinGlyph">M5,1 L11,1 L11,2.5 L10,2.5 L10,7 L12.5,9.5 L12.5,10.5 L8.6,10.5 L8,15.5 L7.4,10.5 L3.5,10.5 L3.5,9.5 L6,7 L6,2.5 L5,2.5 Z</StreamGeometry>
            <!-- A cross, stroked: a tab's close button. -->
            <StreamGeometry x:Key="Tandem.CloseGlyph">M3,3 L13,13 M13,3 L3,13</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- The built-in text editor's own look (AvaloniaEdit's Fluent theme). -->
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <!-- Flat buttons of the bars (volumes, tabs, headers, F-keys, sidebar): they never take the focus, so the
             keyboard stays with the file list. -->
        <Style Selector="Button.flat">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="{DynamicResource Tandem.Transparent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource Tandem.SecondaryForeground}" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="Foreground" Value="{DynamicResource Tandem.SecondaryForeground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="8,8,8,2" />
        </Style>
    </Application.Styles>
</Application>
