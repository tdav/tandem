<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tandem.App.ViewModels"
             xmlns:v="using:Tandem.App.Views"
             x:Class="Tandem.App.Views.FKeyBar"
             x:DataType="vm:MainViewModel">
    <!-- F3–F8: always enabled; a click runs the key's command, or does nothing while it is unavailable. -->
    <Border Background="{DynamicResource Tandem.BarBackground}" BorderBrush="{DynamicResource Tandem.DividerBrush}"
            BorderThickness="0,1,0,0">
        <ItemsControl ItemsSource="{Binding FKeys}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FKeyItem">
                    <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Tag="{Binding CommandId}"
                            Command="{Binding $parent[v:FKeyBar].((vm:MainViewModel)DataContext).FKeyCommand}"
                            CommandParameter="{Binding CommandId}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!-- An unbound command shows its label only. -->
                            <TextBlock Text="{Binding Key}" FontWeight="Bold"
                                       IsVisible="{Binding Key, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding Label}" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
