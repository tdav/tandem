<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:net="using:Tandem.App.Views.Net"
        xmlns:vm="using:Tandem.App.ViewModels.Net"
        x:Class="Tandem.App.Views.Net.TerminalWindow"
        x:DataType="vm:TerminalViewModel"
        Title="{Binding Title}" RequestedThemeVariant="Dark"
        Width="840" Height="500" MinWidth="280" MinHeight="180">
    <net:TerminalView x:Name="ConsoleView" />
</Window>
