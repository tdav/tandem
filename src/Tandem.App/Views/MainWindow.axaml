<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Tandem.App.Commands"
        xmlns:r="using:Tandem.App.Resources"
        xmlns:vm="using:Tandem.App.ViewModels"
        xmlns:v="using:Tandem.App.Views"
        x:Class="Tandem.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Tandem"
        MinWidth="640" MinHeight="400">
    <!-- Top to bottom: the button bar, the two panels (with the sidebar on the left), the command line, the F-key
         bar. On Windows a menu bar goes on top (MainWindow adds it: macOS shows the menu in the system's bar). -->
    <DockPanel x:Name="RootDock">
        <Panel x:Name="ButtonBarHost" DockPanel.Dock="Top" IsVisible="{Binding Workspace.View.ButtonBar}">
            <v:ButtonBar x:Name="ButtonBar" />
        </Panel>
        <v:FKeyBar x:Name="FKeyBar" DockPanel.Dock="Bottom" IsVisible="{Binding Workspace.View.FKeyBar}" />

        <Border DockPanel.Dock="Bottom" IsVisible="{Binding Net.HasOpenConsole}"
                Background="{DynamicResource Tandem.BarBackground}" BorderBrush="{DynamicResource Tandem.DividerBrush}"
                BorderThickness="0,1,0,0" Padding="6,1">
            <Button x:Name="ShowSshConsole" Classes="flat" HorizontalAlignment="Right"
                    Content="{r:Tr Key=Menu_net_console_show}" Command="{Binding RunCommand}"
                    CommandParameter="{x:Static c:CommandIds.NetShowConsole}" />
        </Border>

        <!-- Operations still running or waiting: a click shows the progress window again. -->
        <Border x:Name="OperationsBar" DockPanel.Dock="Bottom" IsVisible="{Binding Operations.HasOperations}"
                Background="{DynamicResource Tandem.BarBackground}" BorderBrush="{DynamicResource Tandem.DividerBrush}"
                BorderThickness="0,1,0,0" Padding="6,1">
            <Button x:Name="OperationsIndicator" Classes="flat" HorizontalAlignment="Right"
                    Content="{Binding Operations.IndicatorText}" Command="{Binding Operations.ShowWindowCommand}" />
        </Border>

        <!-- The command line; its output pane opens above it, under the panels. -->
        <Panel x:Name="CommandLine" DockPanel.Dock="Bottom" IsVisible="{Binding Workspace.View.CommandLine}">
            <v:CommandLineView x:Name="CommandLineView" DataContext="{Binding CommandLine}" />
        </Panel>

        <!-- The output pane and its splitter are shown from code, which sizes their row: zero while the pane is
             closed, its last height while open. -->
        <Grid x:Name="WorkArea" RowDefinitions="*,Auto,0">
            <Grid ColumnDefinitions="Auto,*">
                <v:SidebarView x:Name="Sidebar" Width="200" IsVisible="{Binding Workspace.View.Sidebar}" />
                <Grid x:Name="Panels" Grid.Column="1" ColumnDefinitions="*,4,*">
                    <v:PanelView x:Name="LeftPanel" DataContext="{Binding Left}" />
                    <GridSplitter x:Name="Splitter" Grid.Column="1" ResizeDirection="Columns"
                                  Background="{DynamicResource Tandem.DividerBrush}" />
                    <v:PanelView x:Name="RightPanel" Grid.Column="2" DataContext="{Binding Right}" />
                </Grid>
            </Grid>
            <GridSplitter x:Name="OutputSplitter" Grid.Row="1" ResizeDirection="Rows" Height="4"
                          Background="{DynamicResource Tandem.DividerBrush}" IsVisible="False" />
            <v:OutputPane x:Name="OutputPane" Grid.Row="2" DataContext="{Binding CommandLine}" IsVisible="False" />
        </Grid>
    </DockPanel>
</Window>
