<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tandem.App.ViewModels"
             xmlns:loc="using:Tandem.App.Resources"
             x:Class="Tandem.App.Views.OutputPane"
             x:DataType="vm:CommandLineViewModel">
    <!-- The command line's output: a bar with Kill (while a command runs), Clear and Close, then the text. -->
    <DockPanel Background="{DynamicResource Tandem.BarBackground}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource Tandem.HeaderBackground}"
                BorderBrush="{DynamicResource Tandem.DividerBrush}" BorderThickness="0,0,0,1" Padding="6,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="KillButton" Classes="flat" Content="{loc:Tr Key=Output_Kill}"
                            Command="{Binding KillCommand}" IsVisible="{Binding IsRunning}" />
                    <Button x:Name="ClearButton" Classes="flat" Content="{loc:Tr Key=Output_Clear}"
                            Command="{Binding ClearOutputCommand}" />
                    <Button x:Name="FloatButton" Classes="flat" Content="{loc:Tr Key=Output_Float}"
                            Command="{Binding FloatOutputCommand}" IsVisible="{Binding !IsOutputFloating}" />
                    <Button x:Name="DockButton" Classes="flat" Content="{loc:Tr Key=Output_Dock}"
                            Command="{Binding DockOutputCommand}" IsVisible="{Binding IsOutputFloating}" />
                    <Button x:Name="CloseButton" Classes="flat" Content="{loc:Tr Key=Output_Close}"
                            Command="{Binding CloseOutputCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Classes="secondary" Text="{loc:Tr Key=Output_Title}" />
                    <TextBlock Classes="secondary" Text="{loc:Tr Key=CommandLine_Running}"
                               IsVisible="{Binding IsRunning}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- Read-only but selectable: Cmd+C copies the selection. The text is set from code, which keeps the
             view at the end unless the user has scrolled up. -->
        <TextBox x:Name="OutputText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Menlo, Monaco, Courier New, monospace" FontSize="12" BorderThickness="0"
                 Padding="6,2" MinHeight="0" VerticalContentAlignment="Top"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</UserControl>
