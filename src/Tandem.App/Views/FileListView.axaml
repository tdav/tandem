<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tandem.App.ViewModels"
             xmlns:v="using:Tandem.App.Views"
             xmlns:settings="using:Tandem.Core.Settings"
             xmlns:svg="clr-namespace:Avalonia.Svg;assembly=Svg.Controls.Avalonia"
             x:Class="Tandem.App.Views.FileListView"
             x:DataType="vm:SideViewModel">
    <UserControl.Resources>
        <svg:SvgImage x:Key="FileRowIcon" Source="avares://Tandem.App/Assets/FileIcons/file.svg" />
        <svg:SvgImage x:Key="FolderRowIcon" Source="avares://Tandem.App/Assets/FileIcons/folder.svg" />
        <svg:SvgImage x:Key="ParentRowIcon" Source="avares://Tandem.App/Assets/FileIcons/parent.svg" />
        <!-- Hidden entries draw the same shapes as folder.svg and file.svg, filled with the theme's hidden brushes. -->
        <StreamGeometry x:Key="HiddenFolderBody">M1.5 12.5v-9a1 1 0 0 1 1-1h3.25l1.5 2h6.25a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1Z</StreamGeometry>
        <StreamGeometry x:Key="HiddenFolderDetail">M2 7h12v5.5a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5Z</StreamGeometry>
        <StreamGeometry x:Key="HiddenFileBody">M4.5 1.5h5l3 3v9a1 1 0 0 1-1 1h-7a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1Z</StreamGeometry>
        <StreamGeometry x:Key="HiddenFileDetail">M9.5 1.5v3h3Z</StreamGeometry>
        <StreamGeometry x:Key="HiddenFileLines">M5.5 8.5h5m-5 2.5h4</StreamGeometry>
        <!-- The brief view's items panel; FileListView puts it, BriefRowTemplate and sideways scrolling in place of
             the list's own while the side shows the brief view. -->
        <ItemsPanelTemplate x:Key="BriefPanel">
            <v:BriefColumnsPanel
                ItemHeight="{Binding $parent[v:FileListView].((vm:SideViewModel)DataContext).Layout.RowHeight}" />
        </ItemsPanelTemplate>
        <!-- The brief view's row: the name cell as the full view's (icon, name, rename editor), the name without its
             extension, and the extension at the right edge. A result of another folder does not show where it lies. -->
        <DataTemplate x:Key="BriefRowTemplate" x:DataType="vm:EntryRowViewModel">
            <Grid Classes.marked="{Binding IsSelected}" Classes.folder="{Binding IsDirectoryLike}" ColumnDefinitions="*,Auto">
                <DockPanel x:Name="RowNameCell">
                    <Image DockPanel.Dock="Left" Classes="entryIcon" Classes.folder="{Binding IsDirectoryLike}"
                           Classes.parent="{Binding IsParentLink}" Width="16" Height="16" Margin="0,0,6,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" IsVisible="{Binding !IsHidden}" />
                    <Panel x:Name="HiddenIcon" DockPanel.Dock="Left" Classes="hiddenIcon"
                           Classes.folder="{Binding IsDirectoryLike}" Width="16" Height="16" Margin="0,0,6,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" IsVisible="{Binding IsHidden}">
                        <Path x:Name="HiddenIconBody" />
                        <Path x:Name="HiddenIconDetail" />
                        <Path x:Name="HiddenIconLines" />
                    </Panel>
                    <Panel>
                        <TextBlock x:Name="RowName" Classes="name" Text="{Binding NameWithoutExtension}"
                                   TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsRenaming}" />
                        <ContentControl Content="{Binding Rename}" IsVisible="{Binding IsRenaming}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:InlineRenameViewModel">
                                    <v:InlineRenameEditor />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Panel>
                </DockPanel>
                <TextBlock x:Name="RowExtension" Grid.Column="1" Text="{Binding Extension}" Margin="6,0,2,0"
                           IsVisible="{Binding !IsRenaming}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Image.entryIcon">
            <Setter Property="Source" Value="{StaticResource FileRowIcon}" />
        </Style>
        <Style Selector="Image.entryIcon.folder">
            <Setter Property="Source" Value="{StaticResource FolderRowIcon}" />
        </Style>
        <Style Selector="Image.entryIcon.parent">
            <Setter Property="Source" Value="{StaticResource ParentRowIcon}" />
        </Style>
        <!-- Hidden entries: the icon in the hidden colour, a file's shape or a folder's. Only the icon: a colour rule
             and the marked style colour the name (TextBlocks), so the three never compete. -->
        <Style Selector="Panel.hiddenIcon Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="StrokeLineCap" Value="Round" />
        </Style>
        <!-- A hidden file: a pale page with a darker folded corner; a hidden folder: a darker body with a pale band. -->
        <Style Selector="Panel.hiddenIcon Path#HiddenIconBody">
            <Setter Property="Data" Value="{StaticResource HiddenFileBody}" />
            <Setter Property="Fill" Value="{DynamicResource Tandem.HiddenIconAccent}" />
            <Setter Property="Stroke" Value="{DynamicResource Tandem.HiddenIconBorder}" />
        </Style>
        <Style Selector="Panel.hiddenIcon Path#HiddenIconDetail">
            <Setter Property="Data" Value="{StaticResource HiddenFileDetail}" />
            <Setter Property="Fill" Value="{DynamicResource Tandem.HiddenIcon}" />
            <Setter Property="Stroke" Value="{DynamicResource Tandem.HiddenIconBorder}" />
        </Style>
        <Style Selector="Panel.hiddenIcon Path#HiddenIconLines">
            <Setter Property="Data" Value="{StaticResource HiddenFileLines}" />
            <Setter Property="Stroke" Value="{DynamicResource Tandem.HiddenIconBorder}" />
        </Style>
        <Style Selector="Panel.hiddenIcon.folder Path#HiddenIconBody">
            <Setter Property="Data" Value="{StaticResource HiddenFolderBody}" />
            <Setter Property="Fill" Value="{DynamicResource Tandem.HiddenIcon}" />
        </Style>
        <Style Selector="Panel.hiddenIcon.folder Path#HiddenIconDetail">
            <Setter Property="Data" Value="{StaticResource HiddenFolderDetail}" />
            <Setter Property="Fill" Value="{DynamicResource Tandem.HiddenIconAccent}" />
            <Setter Property="StrokeThickness" Value="0" />
        </Style>
        <Style Selector="Panel.hiddenIcon.folder Path#HiddenIconLines">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- Fixed row height (from the settings, the same for every row): the virtualizing panel never measures rows
             one by one. -->
        <Style Selector="ListBox#Rows ListBoxItem">
            <Setter Property="Height" Value="{Binding $parent[v:FileListView].((vm:SideViewModel)DataContext).Layout.RowHeight}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="{StaticResource Tandem.ListItemPadding}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- The cursor: a filled row in the active panel, an outlined row in the other one. -->
        <Style Selector="ListBox#Rows ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Tandem.CursorBackground}" />
        </Style>
        <Style Selector="ListBox#Rows ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Tandem.CursorBackground}" />
        </Style>
        <Style Selector="ListBox#Rows.inactive ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Tandem.Transparent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Tandem.CursorBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- Files matching a colour rule: the rule's palette colour (FileListView sets the class "file" + colour name
             on the row). Marked rows below win over these. -->
        <Style Selector="ListBox#Rows ListBoxItem.fileRed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Tandem.FileColor.Red}" />
        </Style>
        <Style Selector="ListBox#Rows ListBoxItem.fileOrange TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Tandem.FileColor.Orange}" />
        </Style>
        <Style Selector="ListBox#Rows ListBoxItem.fileYellow TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Tandem.FileColor.Yellow}" />
        </Style>
        <Style Selector="ListBox#Rows ListBoxItem.fileGreen TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Tandem.FileColor.Green}" />
        </Style>
        <Style Selector="ListBox#Rows ListBoxItem.fileTeal TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Tandem.FileColor.Teal}" />
        </Style>
        <Style Selector="ListBox#Rows ListBoxItem.fileBlue TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Tandem.FileColor.Blue}" />
        </Style>
        <Style Selector="ListBox#Rows ListBoxItem.filePurple TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Tandem.FileColor.Purple}" />
        </Style>
        <Style Selector="ListBox#Rows ListBoxItem.fileGray TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Tandem.FileColor.Gray}" />
        </Style>
        <!-- Where an entry of another folder (a search result) lies, after its name. Before the marked style, which
             colours it too. -->
        <Style Selector="TextBlock.location">
            <Setter Property="Foreground" Value="{DynamicResource Tandem.SecondaryForeground}" />
        </Style>
        <!-- Marked rows: coloured text. -->
        <Style Selector="Grid.marked TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Tandem.MarkedForeground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBox.error">
            <Setter Property="BorderBrush" Value="{DynamicResource Tandem.ErrorForeground}" />
        </Style>
        <!-- Drag and drop: the folder row a drop would go into, or the whole list for the panel's own folder. -->
        <Style Selector="ListBox#Rows ListBoxItem.dropTarget /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Tandem.DropTargetBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Tandem.DropTargetBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ListBox#Rows ListBoxItem.dropTarget:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Tandem.DropTargetBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Tandem.DropTargetBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ListBox#Rows.dropTarget">
            <Setter Property="Background" Value="{DynamicResource Tandem.DropTargetBackground}" />
        </Style>
        <Style Selector="Grid.folder TextBlock.name">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <!-- The list's own selection is the cursor only (one way, from CursorIndex); marking is EntryRowViewModel.IsSelected.
         Clicks and keys are handled before the list sees them. -->
    <v:PanelListBox x:Name="Rows"
             ItemsSource="{Binding Panel.Rows}"
             SelectedIndex="{Binding Panel.CursorIndex, Mode=OneWay}"
             SelectionMode="Single"
             IsTextSearchEnabled="False"
             FontSize="{Binding Layout.FontSize}"
             AutoScrollToSelectedItem="True"
             Classes.inactive="{Binding !IsActive}"
             DragDrop.AllowDrop="True"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <v:PanelListBox.ItemsPanel>
            <ItemsPanelTemplate>
                <VirtualizingStackPanel />
            </ItemsPanelTemplate>
        </v:PanelListBox.ItemsPanel>
        <v:PanelListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:EntryRowViewModel">
                <!-- Cells laid out by the side's list layout, as the column headers are. -->
                <Grid Classes.marked="{Binding IsSelected}" Classes.folder="{Binding IsDirectoryLike}"
                      ColumnDefinitions="*,0,0,0,0"
                      v:ListLayoutColumns.Layout="{Binding $parent[v:FileListView].((vm:SideViewModel)DataContext).Layout}">
                    <DockPanel x:Name="RowNameCell">
                        <Image DockPanel.Dock="Left" Classes="entryIcon" Classes.folder="{Binding IsDirectoryLike}"
                               Classes.parent="{Binding IsParentLink}" Width="16" Height="16" Margin="0,0,6,0"
                               VerticalAlignment="Center" IsHitTestVisible="False" IsVisible="{Binding !IsHidden}" />
                        <Panel x:Name="HiddenIcon" DockPanel.Dock="Left" Classes="hiddenIcon"
                               Classes.folder="{Binding IsDirectoryLike}" Width="16" Height="16" Margin="0,0,6,0"
                               VerticalAlignment="Center" IsHitTestVisible="False" IsVisible="{Binding IsHidden}">
                            <Path x:Name="HiddenIconBody" />
                            <Path x:Name="HiddenIconDetail" />
                            <Path x:Name="HiddenIconLines" />
                        </Panel>
                        <Panel>
                            <!-- The name is measured first, leaving the remaining room for the result location. -->
                            <DockPanel IsVisible="{Binding !IsRenaming}">
                                <TextBlock x:Name="RowName" DockPanel.Dock="Left" Classes="name" Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="LocationText" Classes="location" Text="{Binding LocationText}"
                                           IsVisible="{Binding IsForeign}" TextTrimming="CharacterEllipsis"
                                           Margin="8,0,0,0" />
                            </DockPanel>
                            <!-- The inline rename editor, created only while the row is being renamed. -->
                            <ContentControl Content="{Binding Rename}" IsVisible="{Binding IsRenaming}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:InlineRenameViewModel">
                                        <v:InlineRenameEditor />
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </Panel>
                    </DockPanel>
                    <TextBlock x:Name="RowExtension" v:ListLayoutColumns.Cell="{x:Static settings:ColumnId.Extension}"
                               Text="{Binding Extension}" TextTrimming="CharacterEllipsis" Margin="6,0,0,0" />
                    <TextBlock x:Name="RowSize" v:ListLayoutColumns.Cell="{x:Static settings:ColumnId.Size}"
                               Text="{Binding SizeText}" TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    <TextBlock x:Name="RowModified" v:ListLayoutColumns.Cell="{x:Static settings:ColumnId.Modified}"
                               Text="{Binding DateText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="RowMode" v:ListLayoutColumns.Cell="{x:Static settings:ColumnId.Mode}"
                               Text="{Binding ModeText}" TextTrimming="CharacterEllipsis" />
                </Grid>
            </DataTemplate>
        </v:PanelListBox.ItemTemplate>
    </v:PanelListBox>
</UserControl>
