<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Tandem.App</AssemblyName>
    <RootNamespace>Tandem.App</RootNamespace>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- The exe's icon in Explorer (Windows). Generated from build/icon/tandem.svg by build/icon/make-icons.py. -->
    <ApplicationIcon>Assets\Tandem.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Windows: `dotnet publish -r win-x64` compiles natively (Native AOT) by default: one Tandem.App.exe plus the
       native libraries of Skia, HarfBuzz and ANGLE beside it, no .NET to install. It needs a Windows host with the
       MSVC build tools (the GitHub Actions windows runner); it cannot be cross-compiled from macOS. macOS publishes
       choose AOT themselves (build/make-aot-app.sh). -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Svg.Controls.Avalonia" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/FileIcons/*.svg" />
    <AvaloniaResource Include="Assets/Tandem.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tandem.Core\Tandem.Core.csproj" />
    <ProjectReference Include="..\Tandem.Platform.Mac\Tandem.Platform.Mac.csproj" />
    <ProjectReference Include="..\Tandem.Platform.Windows\Tandem.Platform.Windows.csproj" />
    <ProjectReference Include="..\Tandem.Archives\Tandem.Archives.csproj" />
    <ProjectReference Include="..\Tandem.Net\Tandem.Net.csproj" />
  </ItemGroup>
</Project>
